# copiar este archivo como .env y completar
# para desarrollo local con SQLite: DATABASE_URL=sqlite:///./foodstore.db
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/foodstore_db

# minimo 32 caracteres. generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambiar-esta-clave-de-al-menos-32-caracteres
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# origen del frontend permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173
